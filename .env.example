# ============================================================
# GD4 Assistant — Modèle de variables d'environnement
# ------------------------------------------------------------
# 1) Copie ce fichier en ".env"   (ne commit JAMAIS le .env)
# 2) Colle TES clés dedans
# 3) Sur l'hébergeur (Vercel/Netlify/Railway) : ajoute ces
#    mêmes clés dans les "Variables d'environnement"
# ============================================================

# --- ⚡ GROQ (https://console.groq.com → API Keys) ---
PUBLIC_GROQ_API_KEY=
PUBLIC_GROQ_BASE_URL=https://api.groq.com/openai/v1
PUBLIC_GROQ_MODEL=qwen/qwen3.8-27b

# --- 🟢 NVIDIA NIM (https://build.nvidia.com → Generate API Key) ---
PUBLIC_NVIDIA_API_KEY=
PUBLIC_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
PUBLIC_NVIDIA_MODEL=deepseek-ai/deepseek-v4-flash-0731

# --- ☁️ Cloudflare Workers AI (https://dash.cloudflare.com) ---
PUBLIC_CLOUDFLARE_API_KEY=
PUBLIC_CLOUDFLARE_ACCOUNT_ID=
PUBLIC_CLOUDFLARE_MODEL=@cf/qwen/qwen3.8-27b

# --- ☁️ Supabase (https://supabase.com → Project Settings → API) ---
# URL + clé anon : utilisées par le navigateur (pas un secret)
SUPABASE_URL=
# Clé service_role : SERVEUR UNIQUEMENT (jamais côté client !)
# Nécessaire pour /api/apply-promo (codes promo) et le quota tokens.
SUPABASE_SERVICE_ROLE_KEY=

# --- 🖥️ Relais local (optionnel, pour le plugin Godot) ---
# GD4_PIN=GD4-XXXX
# GD4_ALLOWED_ORIGINS=https://ton-site.exemple