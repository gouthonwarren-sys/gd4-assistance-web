# ============================================================
# GD4 Assistant — Modèle de variables d'environnement
# ------------------------------------------------------------
# 1) Copie ce fichier en ".env"   (ne commit JAMAIS le .env)
# 2) Colle TES clés dedans
# 3) Sur l'hébergeur (Netlify) : ajoute ces mêmes clés dans
#    "Environment variables" (voir NETLIFY_VARS.txt)
#
# ⚠️ AUCUNE variable ne doit commencer par PUBLIC_ :
# Astro/Vite recopie les PUBLIC_* dans `import.meta.env`, qui est
# inliné EN CLAIR dans le bundle de la fonction Netlify → Netlify
# affiche « Exposed secrets detected » et bloque le déploiement.
# Ces variables sont lues au runtime par src/lib/serverEnv.ts
# (→ process.env), donc côté serveur uniquement.
# ============================================================

# --- ⚡ GROQ (https://console.groq.com → API Keys) ---
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.8-27b

# --- 🟢 NVIDIA NIM (https://build.nvidia.com → Generate API Key) ---
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=deepseek-ai/deepseek-v4-flash-0731

# --- ☁️ Cloudflare Workers AI (https://dash.cloudflare.com) ---
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/qwen/qwen3.8-27b

# --- ☁️ Supabase (https://supabase.com → Project Settings → API) ---
# URL + clé anon : côté serveur ici ; la clé anon est aussi utilisée
# par le navigateur (ce n'est pas un secret).
SUPABASE_URL=
# Clé service_role : SERVEUR UNIQUEMENT (jamais côté client !)
# Nécessaire pour /api/apply-promo (codes promo) et le quota tokens.
SUPABASE_SERVICE_ROLE_KEY=

# --- 🖥️ Relais local (optionnel, pour le plugin Godot) ---
# GD4_PIN=GD4-XXXX
# GD4_ALLOWED_ORIGINS=https://ton-site.exemple

# --- 🖥️ Relais local (optionnel, pour le plugin Godot) ---
# GD4_PIN=GD4-XXXX
# GD4_ALLOWED_ORIGINS=https://ton-site.exemple