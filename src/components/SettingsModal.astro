---
import SettingsGeneral from './settings/SettingsGeneral.astro';
import SettingsGodot from './settings/SettingsGodot.astro';
import SettingsAI from './settings/SettingsAI.astro';
import SettingsAccount from './settings/SettingsAccount.astro';
---

<div id="settingsModal" class="hidden fixed inset-0 bg-black/75 backdrop-blur-md z-50 flex items-center justify-center p-6 animate-fade-in">

  <div class="bg-[#16181c] border border-slate-700/60 w-full max-w-5xl h-[650px] rounded-3xl shadow-2xl flex overflow-hidden relative">

    <!-- Croix de fermeture -->
    <button id="closeSettingsModalCross" type="button" class="absolute top-5 right-5 text-slate-400 hover:text-white bg-slate-800/50 hover:bg-slate-700/80 w-8 h-8 rounded-full flex items-center justify-center transition z-10 cursor-pointer">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- Navigation Gauche -->
    <aside class="w-64 bg-[#111316] border-r border-slate-800/80 p-6 flex flex-col justify-between select-none shrink-0">
      <div class="space-y-6">
        <div>
          <h3 class="text-xs font-bold text-slate-400 uppercase tracking-widest" data-i18n="settings.title">Paramètres</h3>
          <p class="text-[11px] text-slate-500 mt-1">GD4 Assistant v1.0</p>
        </div>

        <nav class="space-y-1 text-xs font-medium">
          <button type="button" data-tab="tab-general" class="tab-btn w-full text-left px-3.5 py-3 rounded-xl flex items-center gap-3 bg-slate-800/90 text-white transition">
            <svg class="w-4 h-4 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            <span data-i18n="settings.general.tab">Général</span>
          </button>

          <button type="button" data-tab="tab-godot" class="tab-btn w-full text-left px-3.5 py-3 rounded-xl flex items-center gap-3 text-slate-400 hover:bg-slate-800/40 hover:text-slate-200 transition">
            <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            <span data-i18n="settings.godot.tab">Plugin Godot 4</span>
          </button>

          <button type="button" data-tab="tab-ai" class="tab-btn w-full text-left px-3.5 py-3 rounded-xl flex items-center gap-3 text-slate-400 hover:bg-slate-800/40 hover:text-slate-200 transition">
            <svg class="w-4 h-4 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
            <span data-i18n="settings.ai.tab">Instructions & Modèles</span>
          </button>

          <!-- Onglet Modèles IA -->
          <button type="button" data-tab="tab-models" class="tab-btn w-full text-left px-3.5 py-3 rounded-xl flex items-center gap-3 text-slate-400 hover:bg-slate-800/40 hover:text-slate-200 transition">
            <svg class="w-4 h-4 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>
            <span data-i18n="settings.models.tab">Modèles IA</span>
          </button>

          <button type="button" data-tab="tab-account" class="tab-btn w-full text-left px-3.5 py-3 rounded-xl flex items-center gap-3 text-slate-400 hover:bg-slate-800/40 hover:text-slate-200 transition">
            <svg class="w-4 h-4 text-sky-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
            <span data-i18n="settings.account.tab">Compte & Profil</span>
          </button>
        </nav>
      </div>

      <button id="saveSettingsBtn" type="button" class="w-full bg-cyan-600 hover:bg-cyan-500 text-white font-medium text-xs py-3 rounded-xl transition cursor-pointer shadow-lg shadow-cyan-950/40">
        <span data-i18n="settings.save">Enregistrer les modifications</span>
      </button>
    </aside>

    <!-- Zone Onglets -->
    <main id="settingsTabContainer" class="flex-1 p-6 overflow-y-auto bg-[#16181c]">
      <SettingsGeneral />
      <SettingsGodot />
      <SettingsAI />

      <div id="tab-context" class="tab-content hidden space-y-6">
        <div class="pb-4 border-b border-slate-800">
          <h2 class="text-xl font-semibold text-white">Mémoire de projet</h2>
          <p class="text-xs text-slate-400 mt-1">
            Écris ici le contexte global du projet : architecture, objectifs, contraintes, gameplay, scripts clés. Ce texte est réinjecté automatiquement à chaque nouveau cycle afin que le modèle ne perde pas le fil du projet.
          </p>
        </div>

        <div class="space-y-2">
          <textarea
            id="projectMemoryTextarea"
            rows="12"
            placeholder="Exemple :
- Projet : jeu 2D / Godot 4
- Cible : personnage principal, inventaire, combat, UI...
- Architecture : Player.gd, Enemy.gd, GameManager.gd
- Règles : garder le jeu compatible 2D, utiliser InputMap, éviter la logique dans les scenes...
- État actuel : écran de menu presque fini, système de sauvegarde en cours..."
            class="w-full bg-[#111316] border border-slate-800 text-xs text-slate-200 p-4 rounded-2xl focus:outline-none focus:border-violet-500 resize-none font-mono leading-relaxed"
          ></textarea>
        </div>
      </div>

      <!-- ONGLET MODÈLES IA (Contenu de l'image 2) -->
      <div id="tab-models" class="tab-content hidden space-y-6">
        <div>
          <h2 class="text-xl font-bold text-white">Modèles IA</h2>
          <p class="text-xs text-slate-400 mt-1">
            Choisis le cerveau utilisé par l'app. Ce choix pilote le sélecteur de l'en-tête, le Mode Auto, et est appliqué immédiatement.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          
          <!-- Carte : Auto (Intelligent) -->
          <label class="relative border border-slate-800 bg-[#111316] rounded-2xl p-5 flex flex-col justify-between cursor-pointer hover:border-slate-700 transition">
            <input type="radio" name="selected_model" value="auto" class="absolute top-4 right-4 text-cyan-500 focus:ring-cyan-500" />
            <div>
              <div class="flex items-center gap-2 mb-2">
                <span class="text-violet-400 text-lg">✨</span>
                <h3 class="text-base font-bold text-white">Auto (Intelligent)</h3>
              </div>
              <span class="inline-block text-[10px] bg-violet-950/60 text-violet-300 font-mono px-2 py-0.5 rounded border border-violet-800/40 mb-3">
                Routage automatique
              </span>
              <p class="text-[11px] text-slate-400 leading-relaxed mb-4">
                GD4 choisit tout seul le meilleur modèle selon ta demande : cerveau principal par défaut, secours si besoin.
              </p>
              <ul class="text-[11px] text-slate-300 space-y-1.5 mb-4 border-t border-slate-800/60 pt-3">
                <li>• <strong class="text-slate-200">Comportement :</strong> utilise le modèle préféré défini ici</li>
                <li>• <strong class="text-slate-200">Idéal pour :</strong> ne jamais avoir à y penser</li>
              </ul>
            </div>
            <div class="border-t border-slate-800/60 pt-3 text-[10px] text-slate-400">
              <p><strong class="text-slate-300">Recommandé pour :</strong> la plupart des développeurs.</p>
              <p class="mt-1 text-slate-300 font-semibold">Simplicité : <span class="text-emerald-400 font-normal">Maximale</span></p>
            </div>
          </label>

          <!-- Carte : Qwen 3.8 27B (cerveau principal) -->
          <label class="relative border border-cyan-500/50 bg-[#131722] rounded-2xl p-5 flex flex-col justify-between cursor-pointer hover:border-cyan-400 transition shadow-lg shadow-cyan-950/20">
            <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-cyan-500 text-slate-950 text-[9px] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full">
              Cerveau principal
            </div>
            <input type="radio" name="selected_model" value="groq" class="absolute top-4 right-4 text-cyan-500 focus:ring-cyan-500" />
            <div>
              <div class="flex items-center gap-2 mb-2 mt-1">
                <span class="text-cyan-400 text-lg">⚡</span>
                <h3 class="text-base font-bold text-white">Qwen 3.8 27B</h3>
              </div>
              <span class="inline-block text-[10px] bg-cyan-950/80 text-cyan-300 font-mono px-2 py-0.5 rounded border border-cyan-700/50 mb-3">
                Qwen 3.8 27B · multimodal
              </span>
              <p class="text-[11px] text-slate-300 leading-relaxed mb-4">
                Le cerveau par défaut : multimodal (lit les captures d'écran Godot) et génère les actions JSON exécutées dans la scène.
              </p>
              <ul class="text-[11px] text-slate-300 space-y-1.5 mb-4 border-t border-slate-800/60 pt-3">
                <li>• <strong class="text-slate-200">Architecture :</strong> Qwen 3.8 27B</li>
                <li>• <strong class="text-slate-200">Domaine :</strong> création de jeu complète, actions Godot, vision d'écran.</li>
              </ul>
            </div>
            <div class="border-t border-slate-800/60 pt-3 text-[10px] text-slate-400">
              <p><strong class="text-slate-300">Cas d'usage :</strong> tout : génération, refactor, correction, analyse de capture.</p>
              <p class="mt-1 text-slate-300 font-semibold">Vitesse : <span class="text-emerald-400 font-normal">Ultra rapide (~450 t/s)</span></p>
            </div>
          </label>

          <!-- Carte : Sprint 4.7 (bientôt disponible) -->
          <label class="relative border border-slate-800 bg-[#111316] rounded-2xl p-5 flex flex-col justify-between opacity-50 cursor-not-allowed select-none">
            <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-slate-700 text-slate-300 text-[9px] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full">
              🔒 Bientôt disponible
            </div>
            <div>
              <div class="flex items-center gap-2 mb-2 mt-1">
                <span class="text-amber-400 text-lg">⚡</span>
                <h3 class="text-base font-bold text-white">Sprint 4.7</h3>
              </div>
              <span class="inline-block text-[10px] bg-slate-800 text-slate-400 font-mono px-2 py-0.5 rounded border border-slate-700/50 mb-3">
                Vitesse absolue
              </span>
              <p class="text-[11px] text-slate-400 leading-relaxed mb-4">
                Optimisé pour la vitesse : autocomplétion et corrections à la volée, directement dans le flux de développement.
              </p>
            </div>
            <div class="border-t border-slate-800/60 pt-3 text-[10px] text-slate-500">
              <p><strong class="text-slate-400">Cas d'usage prévu :</strong> complétion, typage statique, micro-corrections.</p>
            </div>
          </label>

          <!-- Carte : Core 4.7 (bientôt disponible) -->
          <label class="relative border border-slate-800 bg-[#111316] rounded-2xl p-5 flex flex-col justify-between opacity-50 cursor-not-allowed select-none">
            <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-slate-700 text-slate-300 text-[9px] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full">
              🔒 Bientôt disponible
            </div>
            <div>
              <div class="flex items-center gap-2 mb-2 mt-1">
                <span class="text-rose-400 text-lg">🧠</span>
                <h3 class="text-base font-bold text-white">Core 4.7</h3>
              </div>
              <span class="inline-block text-[10px] bg-slate-800 text-slate-400 font-mono px-2 py-0.5 rounded border border-slate-700/50 mb-3">
                Architecture & debug
              </span>
              <p class="text-[11px] text-slate-400 leading-relaxed mb-4">
                Le cœur logique : compréhension de l'architecture du projet, des scènes .tscn et résolution de bugs complexes.
              </p>
            </div>
            <div class="border-t border-slate-800/60 pt-3 text-[10px] text-slate-500">
              <p><strong class="text-slate-400">Cas d'usage prévu :</strong> refactorisation, gestion d'état, architecture de signaux.</p>
            </div>
          </label>

          <!-- Carte : Apex 4.7 (bientôt disponible) -->
          <label class="relative border border-slate-800 bg-[#111316] rounded-2xl p-5 flex flex-col justify-between opacity-50 cursor-not-allowed select-none">
            <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-slate-700 text-slate-300 text-[9px] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full">
              🔒 Bientôt disponible
            </div>
            <div>
              <div class="flex items-center gap-2 mb-2 mt-1">
                <span class="text-emerald-400 text-lg">🌲</span>
                <h3 class="text-base font-bold text-white">Apex 4.7</h3>
              </div>
              <span class="inline-block text-[10px] bg-slate-800 text-slate-400 font-mono px-2 py-0.5 rounded border border-slate-700/50 mb-3">
                Haute performance
              </span>
              <p class="text-[11px] text-slate-400 leading-relaxed mb-4">
                Haute performance pour les tâches exigeantes : shaders Godot (GLSL), génération procédurale et optimisation GPU.
              </p>
            </div>
            <div class="border-t border-slate-800/60 pt-3 text-[10px] text-slate-500">
              <p><strong class="text-slate-400">Cas d'usage prévu :</strong> shaders 2D/3D, physique personnalisée, multithreading.</p>
            </div>
          </label>

        </div>
      </div>

      <SettingsAccount />
    </main>

  </div>

</div>

<script>
  import { supabase } from '../lib/supabase';
  import { resolveCurrentUser, getSetting, setSetting, setSystemPrompt, getProjectMemoryText, setProjectMemoryText } from '../lib/userData';

  const AUTH_KEY = 'gd4_user_session';

  const tabBtns = document.querySelectorAll('.tab-btn');
  const tabContents = document.querySelectorAll('.tab-content');
  const modal = document.getElementById('settingsModal');
  const closeCross = document.getElementById('closeSettingsModalCross');
  const saveBtn = document.getElementById('saveSettingsBtn');
  const settingsTabContainer = document.getElementById('settingsTabContainer');
  const projectMemoryTextarea = document.getElementById('projectMemoryTextarea') as HTMLTextAreaElement | null;
  const themeSelect = document.getElementById('themeSelect') as HTMLSelectElement | null;
  const langSelect = document.getElementById('langSelect') as HTMLSelectElement | null;
  const fontSizeSelect = document.getElementById('fontSizeSelect') as HTMLSelectElement | null;
  const compactModeToggle = document.getElementById('compactModeToggle') as HTMLInputElement | null;
  const portInput = document.getElementById('wsPortInput') as HTMLInputElement | null;

  const translations: Record<string, Record<string, string>> = {
    fr: {
      'settings.title': 'Paramètres', 'settings.general.tab': 'Général', 'settings.godot.tab': 'Plugin Godot 4',
      'settings.ai.tab': 'Instructions & Modèles', 'settings.models.tab': 'Modèles IA', 'settings.account.tab': 'Compte & Profil',
      'settings.save': 'Enregistrer les modifications', 'settings.general.title': 'Préférences Générales',
      'settings.general.subtitle': 'Personnalisez votre expérience visuelle et linguistique.', 'settings.general.theme': "Thème d'affichage",
      'settings.general.themeHint': 'Optimisé pour les longues sessions GDScript', 'settings.general.language': "Langue de l'interface",
      'settings.general.languageHint': "Langue des menus et réponses de l'assistant", 'settings.general.textSize': 'Taille du texte',
      'settings.general.textSizeHint': 'Ajuste le confort de lecture du chat', 'settings.general.density': 'Affichage compact',
      'settings.general.densityHint': "Affiche davantage de messages à l'écran", 'theme.dark': 'Sombre (Godot Dark)',
      'theme.light': 'Clair', 'theme.system': 'Système', 'size.normal': 'Normale', 'size.large': 'Grande',
      'model.auto': '✨ Auto (Sélection Intelligente)', 'model.free': '☁️ DeepSeek R1 32B (Cloudflare)',
      'godot.offline': 'Godot : hors ligne', 'upgrade': 'Mettre à niveau', 'welcome.title': 'Bonjour, que voulez-vous savoir ?',
      'welcome.subtitle': "Demandez la génération d'un script GDScript, un refactoring de nœud 2D/3D ou une correction d'erreur en temps réel.",
      'chat.placeholder': "Comment puis-je vous aider avec Godot 4 aujourd'hui ?", 'deepThink': 'Réflexion profonde', 'capture': 'Capture Godot',
    },
    en: {
      'settings.title': 'Settings', 'settings.general.tab': 'General', 'settings.godot.tab': 'Godot 4 Plugin',
      'settings.ai.tab': 'Instructions & Models', 'settings.models.tab': 'AI Models', 'settings.account.tab': 'Account & Profile',
      'settings.save': 'Save changes', 'settings.general.title': 'General Preferences',
      'settings.general.subtitle': 'Customize your visual and language experience.', 'settings.general.theme': 'Display theme',
      'settings.general.themeHint': 'Optimized for long GDScript sessions', 'settings.general.language': 'Interface language',
      'settings.general.languageHint': 'Language used by menus and assistant replies', 'settings.general.textSize': 'Text size',
      'settings.general.textSizeHint': 'Adjust chat readability', 'settings.general.density': 'Compact layout',
      'settings.general.densityHint': 'Show more messages on screen', 'theme.dark': 'Dark (Godot Dark)',
      'theme.light': 'Light', 'theme.system': 'System', 'size.normal': 'Normal', 'size.large': 'Large',
      'model.auto': '✨ Auto (Smart selection)', 'model.free': '☁️ DeepSeek R1 32B (Cloudflare)',
      'godot.offline': 'Godot: offline', 'upgrade': 'Upgrade', 'welcome.title': 'Hello, what would you like to know?',
      'welcome.subtitle': 'Ask for a GDScript, 2D/3D node refactor, or real-time error fix.',
      'chat.placeholder': 'How can I help you with Godot 4 today?', 'deepThink': 'Deep thinking', 'capture': 'Godot capture',
    },
  };

  function translatePage(language: string) {
    const dictionary = translations[language] || translations.fr;
    document.querySelectorAll<HTMLElement>('[data-i18n]').forEach((element) => {
      const value = dictionary[element.dataset.i18n || ''];
      if (value) element.textContent = value;
    });
    document.querySelectorAll<HTMLElement>('[data-i18n-placeholder]').forEach((element) => {
      const value = dictionary[element.dataset.i18nPlaceholder || ''];
      if (value) element.setAttribute('placeholder', value);
    });
    window.dispatchEvent(new CustomEvent('gd4-language-changed', { detail: { language } }));
  }

  function applyPreferences(theme: string, language: string, fontSize = 'normal', compact = false) {
    const resolvedTheme = theme === 'system'
      ? (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark')
      : theme;
    document.documentElement.lang = language;
    document.documentElement.dataset.theme = resolvedTheme;
    document.documentElement.dataset.themeChoice = theme;
    document.documentElement.dataset.fontSize = fontSize;
    document.documentElement.dataset.density = compact ? 'compact' : 'comfortable';
    document.documentElement.style.colorScheme = resolvedTheme;
    translatePage(language);
  }

  function switchTab(targetId: string) {
    tabBtns.forEach(btn => {
      const isTarget = btn.getAttribute('data-tab') === targetId;
      btn.classList.toggle('bg-slate-800/90', isTarget);
      btn.classList.toggle('text-white', isTarget);
      btn.classList.toggle('text-slate-400', !isTarget);
    });

    tabContents.forEach(content => {
      content.classList.toggle('hidden', content.id !== targetId);
    });
  }

  const closeModal = () => modal?.classList.add('hidden');
  closeCross?.addEventListener('click', closeModal);

  saveBtn?.addEventListener('click', async () => {
    const me = await resolveCurrentUser().catch(() => null);
    const promptArea = document.getElementById('systemPromptTextarea') as HTMLTextAreaElement | null;
    if (promptArea) {
      await setSystemPrompt(promptArea.value, me?.id ?? null);
    }
    if (projectMemoryTextarea) {
      await setProjectMemoryText(projectMemoryTextarea.value, me?.id ?? null);
    }

    const selectedModel = document.querySelector('input[name="selected_model"]:checked') as HTMLInputElement | null;
    if (selectedModel) {
      localStorage.setItem('gd4_selected_model', selectedModel.value);
    }

    const theme = themeSelect?.value || 'dark';
    const language = langSelect?.value || 'fr';
    const fontSize = fontSizeSelect?.value || 'normal';
    const compact = compactModeToggle?.checked || false;
    const port = Number(portInput?.value || 9091);
    applyPreferences(theme, language, fontSize, compact);
    await setSetting(me?.id ?? null, 'theme', theme);
    await setSetting(me?.id ?? null, 'language', language);
    await setSetting(me?.id ?? null, 'fontSize', fontSize);
    await setSetting(me?.id ?? null, 'compactMode', compact);
    if (Number.isInteger(port) && port >= 1 && port <= 65535) {
      await setSetting(me?.id ?? null, 'relayPort', port);
    }

    closeModal();
  });

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const target = btn.getAttribute('data-tab');
      if (target) switchTab(target);
    });
  });

  window.addEventListener('open-settings', ((e: CustomEvent) => {
    const targetTab = e.detail?.tab || 'tab-general';
    switchTab(targetTab);
    modal?.classList.remove('hidden');
  }) as EventListener);

  // Charger le modèle sélectionné
  const savedModel = localStorage.getItem('gd4_selected_model');
  if (savedModel) {
    const radio = document.querySelector(`input[name="selected_model"][value="${savedModel}"]`) as HTMLInputElement | null;
    if (radio) radio.checked = true;
  } else {
    const defaultRadio = document.querySelector(`input[name="selected_model"][value="auto"]`) as HTMLInputElement | null;
    if (defaultRadio) defaultRadio.checked = true;
  }

  // ⚙️ Modèles IA : appliquer IMMÉDIATEMENT le choix au sélecteur du header
  // (pas besoin d'attendre « Enregistrer » — zéro décor, tout est fonctionnel)
  document.querySelectorAll<HTMLInputElement>('input[name="selected_model"]').forEach((radio) => {
    radio.addEventListener('change', () => {
      try { localStorage.setItem('gd4_selected_model', radio.value); } catch { /* ignore */ }
      window.dispatchEvent(new CustomEvent('gd4-model-changed', { detail: { model: radio.value } }));
    });
  });

  (async () => {
    const me = await resolveCurrentUser().catch(() => null);
    const theme = getSetting(me?.id ?? null, 'theme', 'dark');
    const language = getSetting(me?.id ?? null, 'language', 'fr');
    const fontSize = getSetting(me?.id ?? null, 'fontSize', 'normal');
    const compact = getSetting(me?.id ?? null, 'compactMode', false);
    const port = getSetting(me?.id ?? null, 'relayPort', 9091);
    const savedProjectMemory = getProjectMemoryText(me?.id ?? null);
    if (projectMemoryTextarea) projectMemoryTextarea.value = savedProjectMemory;
    if (themeSelect) themeSelect.value = theme;
    if (langSelect) langSelect.value = language;
    if (fontSizeSelect) fontSizeSelect.value = fontSize;
    if (compactModeToggle) compactModeToggle.checked = compact;
    if (portInput) portInput.value = String(port);
    applyPreferences(theme, language, fontSize, compact);
  })();

  matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
    if (themeSelect?.value === 'system') applyPreferences('system', langSelect?.value || 'fr', fontSizeSelect?.value || 'normal', compactModeToggle?.checked || false);
  });

  settingsTabContainer?.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    const logoutBtn = target.closest('#modalLogoutBtn, [data-action="logout"]');

    if (logoutBtn) {
      if (supabase) {
        await supabase.auth.signOut();
      }
      localStorage.removeItem(AUTH_KEY);
      closeModal();
      window.location.reload();
    }
  });
</script>