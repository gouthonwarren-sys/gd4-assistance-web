---
---
<section id="tab-account" class="tab-content space-y-6 hidden">
  <div class="pb-4 border-b border-slate-800">
    <h2 class="text-xl font-semibold text-white">Compte & Authentification</h2>
    <p class="text-xs text-slate-400 mt-1">Gérez votre session développeur pour synchroniser vos projets GDScript.</p>
  </div>
  
  <!-- État de chargement initial (masque le contenu avant détection) -->
  <div id="authLoading" class="p-8 text-center text-slate-500 text-xs flex items-center justify-center gap-2">
    <span class="w-2 h-2 rounded-full bg-cyan-500 animate-ping"></span>
    <span>Vérification de la session en cours...</span>
  </div>

  <!-- Formulaire de Connexion (Utilisateur NON connecté) -->
  <div id="authLoginForm" class="hidden space-y-4">
    <div class="p-5 bg-[#111316] rounded-2xl border border-slate-800/80 space-y-4">
      <h3 class="text-sm font-semibold text-white">Se connecter à GD4 Assistant</h3>
      
      <!-- Bouton Google SSO -->
      <button 
        id="googleAuthBtn"
        type="button"
        class="w-full bg-[#16181c] hover:bg-slate-800 border border-slate-700/80 text-white font-medium text-xs py-3 px-4 rounded-xl transition cursor-pointer flex items-center justify-center gap-3 shadow-sm hover:border-slate-600"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
        </svg>
        <span>Continuer avec Google</span>
      </button>

      <div class="relative flex py-1 items-center">
        <div class="flex-grow border-t border-slate-800"></div>
        <span class="flex-shrink mx-3 text-[10px] text-slate-500 font-medium uppercase tracking-wider">ou par email</span>
        <div class="flex-grow border-t border-slate-800"></div>
      </div>

      <!-- Formulaire classique -->
      <div class="space-y-3">
        <div>
          <label class="block text-xs text-slate-400 mb-1 font-medium">Adresse Email</label>
          <input 
            id="loginEmail" 
            type="email" 
            placeholder="votre.email@exemple.com" 
            class="w-full bg-[#16181c] border border-slate-800 text-xs text-slate-200 px-4 py-2.5 rounded-xl focus:outline-none focus:border-cyan-500 font-sans"
          />
        </div>
        
        <div>
          <label class="block text-xs text-slate-400 mb-1 font-medium">Mot de passe</label>
          <input 
            id="loginPassword" 
            type="password" 
            placeholder="••••••••••••" 
            class="w-full bg-[#16181c] border border-slate-800 text-xs text-slate-200 px-4 py-2.5 rounded-xl focus:outline-none focus:border-cyan-500 font-sans"
          />
        </div>
      </div>

      <div id="authErrorMessage" class="hidden text-xs text-red-400 bg-red-500/10 p-3 rounded-xl border border-red-500/20"></div>

      <button 
        id="submitLoginBtn" 
        type="button"
        class="w-full bg-cyan-600 hover:bg-cyan-500 text-white font-medium text-xs py-3 rounded-xl transition cursor-pointer shadow-lg shadow-cyan-950/40 flex items-center justify-center gap-2"
      >
        <span>Se connecter</span>
      </button>
    </div>
  </div>

  <!-- Profil CONNECTÉ (Affichage dynamique des vraies informations) -->
  <div id="authProfileCard" class="hidden space-y-4">
    <div class="flex items-center justify-between p-5 bg-[#111316] rounded-2xl border border-slate-800/80">
      <div class="flex items-center gap-4">
        <div id="userAvatarContainer" class="w-12 h-12 rounded-full overflow-hidden bg-cyan-600 text-white font-bold flex items-center justify-center text-base border-2 border-cyan-400/30 shrink-0">
          <span id="userAvatarText"></span>
          <img id="userAvatarImg" class="w-full h-full object-cover hidden" alt="Avatar Utilisateur" />
        </div>
        <div class="space-y-0.5">
          <p id="userNameDisplay" class="text-sm font-semibold text-white"></p>
          <p id="userEmailDisplay" class="text-xs text-slate-400"></p>
          <div class="pt-1">
            <span id="userPlanBadge" class="inline-flex items-center text-[10px] font-medium text-cyan-400 bg-cyan-500/10 px-2 py-0.5 rounded-md border border-cyan-500/20">
              Licence Développeur
            </span>
          </div>
        </div>
      </div>
      
      <button 
        id="logoutBtn" 
        type="button"
        class="text-xs text-rose-400 hover:text-white bg-rose-500/10 hover:bg-rose-600 px-4 py-2.5 rounded-xl border border-rose-500/20 transition cursor-pointer font-medium"
      >
        Se déconnecter
      </button>
    </div>
  </div>
</section>

<script>
  import { supabase } from '../../lib/supabase';

  const AUTH_KEY = 'gd4_user_session';

  const authLoading = document.getElementById('authLoading');
  const authLoginForm = document.getElementById('authLoginForm');
  const authProfileCard = document.getElementById('authProfileCard');
  
  const loginEmail = document.getElementById('loginEmail') as HTMLInputElement | null;
  const loginPassword = document.getElementById('loginPassword') as HTMLInputElement | null;
  const submitLoginBtn = document.getElementById('submitLoginBtn');
  const googleAuthBtn = document.getElementById('googleAuthBtn');
  const logoutBtn = document.getElementById('logoutBtn');
  const authErrorMessage = document.getElementById('authErrorMessage');

  const userNameDisplay = document.getElementById('userNameDisplay');
  const userEmailDisplay = document.getElementById('userEmailDisplay');
  const userAvatarText = document.getElementById('userAvatarText');
  const userAvatarImg = document.getElementById('userAvatarImg') as HTMLImageElement | null;

  function updateUI(userData: { name?: string; email: string; avatar_url?: string } | null) {
    authLoading?.classList.add('hidden');

    if (userData) {
      authLoginForm?.classList.add('hidden');
      authProfileCard?.classList.remove('hidden');

      // Insertion du vrai nom ou de l'identifiant extrait
      const displayName = userData.name || userData.email.split('@')[0];
      if (userNameDisplay) userNameDisplay.innerText = displayName;
      if (userEmailDisplay) userEmailDisplay.innerText = userData.email;

      // Gestion de la photo de profil réelle (depuis Google / Supabase)
      if (userData.avatar_url && userAvatarImg) {
        userAvatarImg.src = userData.avatar_url;
        userAvatarImg.classList.remove('hidden');
        userAvatarText?.classList.add('hidden');
      } else if (userAvatarText) {
        userAvatarImg?.classList.add('hidden');
        userAvatarText.classList.remove('hidden');
        userAvatarText.innerText = displayName.charAt(0).toUpperCase();
      }
    } else {
      authLoginForm?.classList.remove('hidden');
      authProfileCard?.classList.add('hidden');
    }
  }

  // ÉCOUTEUR SUPABASE EN TEMPS RÉEL
  if (supabase) {
    supabase.auth.onAuthStateChange((event, session) => {
      if (session?.user) {
        const realUserData = {
          email: session.user.email || '',
          name: session.user.user_metadata?.full_name || session.user.user_metadata?.name || '',
          avatar_url: session.user.user_metadata?.avatar_url || session.user.user_metadata?.picture || '',
          id: session.user.id
        };
        localStorage.setItem(AUTH_KEY, JSON.stringify(realUserData));
        updateUI(realUserData);
      } else {
        localStorage.removeItem(AUTH_KEY);
        updateUI(null);
      }
    });
  } else {
    // Mode de secours via localStorage si Supabase est déconnecté
    const savedSession = localStorage.getItem(AUTH_KEY);
    if (savedSession) {
      try { updateUI(JSON.parse(savedSession)); } catch { updateUI(null); }
    } else {
      updateUI(null);
    }
  }

  // Action : Connexion Google
  googleAuthBtn?.addEventListener('click', async () => {
    try {
      if (supabase) {
        const { error } = await supabase.auth.signInWithOAuth({
          provider: 'google',
          options: {
            redirectTo: window.location.origin
          }
        });
        if (error) throw error;
      }
    } catch (err: any) {
      if (authErrorMessage) {
        authErrorMessage.innerText = err?.message || "Erreur lors de l'authentification Google.";
        authErrorMessage.classList.remove('hidden');
      }
    }
  });

  // Action : Connexion par Email
  submitLoginBtn?.addEventListener('click', async () => {
    const email = loginEmail?.value.trim();
    const password = loginPassword?.value.trim();

    if (!email || !password) {
      if (authErrorMessage) {
        authErrorMessage.innerText = "Veuillez saisir votre email et votre mot de passe.";
        authErrorMessage.classList.remove('hidden');
      }
      return;
    }

    if (supabase) {
      const { error } = await supabase.auth.signInWithPassword({ email, password });
      if (error && authErrorMessage) {
        authErrorMessage.innerText = error.message;
        authErrorMessage.classList.remove('hidden');
      }
    }
  });

  // Action : Déconnexion
  logoutBtn?.addEventListener('click', async () => {
    if (supabase) {
      await supabase.auth.signOut();
    }
    localStorage.removeItem(AUTH_KEY);
    updateUI(null);
  });
</script>