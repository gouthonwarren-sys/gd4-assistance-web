      attachImageBtn?.addEventListener('click', () => attachImageInput?.click());
      attachmentMenuBtn?.addEventListener('click', () => {
        const isHidden = attachmentMenu?.classList.toggle('hidden') ?? true;
        attachmentMenuBtn.setAttribute('aria-expanded', String(!isHidden));
      });
      document.addEventListener('click', (event) => {
        const target = event.target as Node;
        if (!attachmentMenu?.contains(target) && !attachmentMenuBtn?.contains(target)) {
          attachmentMenu?.classList.add('hidden');
