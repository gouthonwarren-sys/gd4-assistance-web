          appendMessageUI('assistant', '📸 Capture Godot demandée…', 'Système');
          if (captureTimeout) clearTimeout(captureTimeout);
          captureTimeout = setTimeout(() => {
            captureTimeout = null;
            if (!currentScreenshot) {
              appendMessageUI('assistant', '⚠️ Godot n’a pas renvoyé la capture. Vérifie que le plugin est connecté (pastille verte) puis réessaie.', 'Système');
            }
          }, 10000);
        } else {
          appendMessageUI('assistant', '⚠️ Relais hors ligne — impossible de capturer Godot. Tu peux coller une image avec Ctrl+V ou en joindre une.', 'Système');
        }
