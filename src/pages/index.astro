      });
      attachImageInput?.addEventListener('change', () => {
        attachmentMenu?.classList.add('hidden');
        attachmentMenuBtn?.setAttribute('aria-expanded', 'false');
        const file = attachImageInput.files?.[0];
        if (!file) return;
        if (!file.type.startsWith('image/')) {
          appendMessageUI('assistant', '⚠️ Sélectionne un fichier image.', 'Système');
          attachImageInput.value = '';
          return;
        }
        const reader = new FileReader();
        reader.onload = () => {
          const result = typeof reader.result === 'string' ? reader.result : '';
          currentScreenshot = result.includes(',') ? result.split(',')[1] : result;
          currentScreenshotMime = file.type || 'image/png';
          attachBadge?.classList.remove('hidden');
          attachBadge!.textContent = `🖼️ ${file.name}`;
        };
        reader.readAsDataURL(file);
      });

      // ============================================================
      // 📋 CTRL+V — coller une image directement dans le chat
      // ============================================================
      function attachImageFromBase64(b64: string, mime: string, label: string): void {
        currentScreenshot = b64;
        currentScreenshotMime = mime || 'image/png';
        appendScreenshotUI(b64, currentScreenshotMime, label);
        attachBadge?.classList.remove('hidden');
        if (attachBadge) attachBadge.textContent = '📋 image collée';
      }

      document.addEventListener('paste', (event: ClipboardEvent) => {
        const items = event.clipboardData?.items;
        if (!items) return;
        for (const item of Array.from(items)) {
          if (!item.type.startsWith('image/')) continue;
          const file = item.getAsFile();
          if (!file) continue;
          event.preventDefault();   // on garde la main (pas de collage de texte parasite)
          const reader = new FileReader();
          reader.onload = () => {
            const result = typeof reader.result === 'string' ? reader.result : '';
            const b64 = result.includes(',') ? result.split(',')[1] : result;
            if (b64) attachImageFromBase64(b64, item.type || file.type || 'image/png', 'Image collée (Ctrl+V)');
          };
          reader.readAsDataURL(file);
          return;
        }
      });

      deepThinkToggle?.addEventListener('click', () => {
        deepThinkOn = !deepThinkOn;
        deepThinkToggle.classList.toggle('text-cyan-400', deepThinkOn);
        deepThinkToggle.classList.toggle('text-slate-400', !deepThinkOn);
      });

      // 🧠 Toggle mémoire/contexte projet — ON par défaut, mémorisé
      let memoryOn = true;
      const memoryToggle = document.getElementById('memoryToggle') as HTMLButtonElement | null;
      try { memoryOn = localStorage.getItem('gd4_memory_on') !== 'off'; } catch { /* ignore */ }
      function paintMemoryToggle(): void {
        memoryToggle?.classList.toggle('text-violet-300', memoryOn);
        memoryToggle?.classList.toggle('text-slate-400', !memoryOn);
      }
      paintMemoryToggle();
      memoryToggle?.addEventListener('click', () => {
        memoryOn = !memoryOn;
        try { localStorage.setItem('gd4_memory_on', memoryOn ? 'on' : 'off'); } catch { /* ignore */ }
        paintMemoryToggle();
        appendMessageUI('assistant', memoryOn
          ? '🧠 Contexte projet ACTIVÉ — le modèle reçoit le résumé de la conversation + le journal des actions.'
          : '🧠 Contexte projet DÉSACTIVÉ — le modèle répond sans le fil des échanges précédents.', 'Système');
      });

      // 🎤 Dictée vocale (Web Speech API) — dicte ta question au micro
      const SpeechRec: any = (window as any).SpeechRecognition || (window as any).webkitSpeechRecognition;
      let recognition: any = null;
      let listening = false;
      document.getElementById('voiceInputBtn')?.addEventListener('click', () => {
        const micBtn = document.getElementById('voiceInputBtn') as HTMLButtonElement | null;
        if (!SpeechRec) {
          appendMessageUI('assistant', '⚠️ La dictée vocale n\'est pas supportée par ce navigateur.', 'Système');
          return;
        }
        if (listening) { recognition?.stop(); return; }
        try {
          recognition = new SpeechRec();
          recognition.lang = 'fr-FR';
          recognition.interimResults = false;
          recognition.continuous = false;
          recognition.onstart = () => { listening = true; if (micBtn) { micBtn.textContent = '🔴'; micBtn.classList.add('text-red-400'); } };
          recognition.onend = () => { listening = false; if (micBtn) { micBtn.textContent = '🎤'; micBtn.classList.remove('text-red-400'); } };
          recognition.onerror = () => { listening = false; if (micBtn) { micBtn.textContent = '🎤'; micBtn.classList.remove('text-red-400'); } };
          recognition.onresult = (e: any) => {
            const said = Array.from(e.results).map((r: any) => r[0].transcript).join(' ').trim();
            if (said && promptInput) {
              promptInput.value = (promptInput.value ? promptInput.value + ' ' : '') + said;
              promptInput.focus();
              promptInput.dispatchEvent(new Event('input'));
            }
          };
          recognition.start();
        } catch { listening = false; }
      });

      // ⚡ Prompts rapides — un clic préremplit le champ (exclusivité GD4)
      document.getElementById('quickPrompts')?.addEventListener('click', (e) => {
        const chip = (e.target as HTMLElement).closest<HTMLButtonElement>('.quick-prompt-chip');
        if (!chip || !promptInput) return;
        promptInput.value = chip.dataset.prompt || '';
        promptInput.focus();
      });

      // 🧮 Compteur live : caractères + tokens estimés (≈ 1 token / 4 caractères)
      promptInput?.addEventListener('input', () => {
        const counter = document.getElementById('promptCounter');
        if (!counter || !promptInput) return;
        const len = promptInput.value.length;
        counter.textContent = len ? `~${Math.max(1, Math.ceil(len / 4))} tokens · ${len} car.` : '';
      });

      // 📊 Statistiques d'usage locales (réinitialisées chaque jour)
      function bumpUsage(addMessage: boolean, inputTokens = 0, outputTokens = 0): void {
        try {
          const today = new Date().toISOString().slice(0, 10);
          const raw = JSON.parse(localStorage.getItem('gd4_usage_stats') || 'null');
          const s = (raw && raw.day === today) ? raw : { day: today, messages: 0, inputTokens: 0, outputTokens: 0 };
          if (addMessage) s.messages += 1;
          s.inputTokens += inputTokens;
          s.outputTokens += outputTokens;
          localStorage.setItem('gd4_usage_stats', JSON.stringify(s));
        } catch { /* ignore */ }
      }

      // ⬇️ EXPORT MARKDOWN de la conversation active (doc de projet, partage)
      document.getElementById('exportMdBtn')?.addEventListener('click', () => {
        const chats = getChats(currentUserId);
        const chat = (currentChatId ? chats.find((c: Chat) => c.id === currentChatId) : undefined) || chats[0];
        if (!chat || !chat.messages?.length) {
          appendMessageUI('assistant', '⚠️ Aucune conversation à exporter.', 'Système');
          return;
        }
        const lines: string[] = [`# ${chat.title}`, '', `_Exporté depuis GD4 Assistant le ${new Date().toLocaleString('fr-FR')}_`, ''];
        for (const m of chat.messages) {
          lines.push(m.role === 'user' ? `## 🧑 Développeur\n\n${m.text}\n` : `## 🤖 Assistant\n\n${m.text}\n`);
        }
        const blob = new Blob([lines.join('\n')], { type: 'text/markdown;charset=utf-8' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = `${(chat.title || 'conversation').replace(/[^\w\- àâäéèêëîïôöùûüç]+/gi, '').slice(0, 60)}.md`;
        a.click();
        URL.revokeObjectURL(a.href);
        appendMessageUI('assistant', '⬇️ Conversation exportée en Markdown (.md).', 'Système');
      });

      // 📜 JOURNAL des actions appliquées — la mémoire du modèle rendue VISIBLE
      // (nouveauté exclusive : le dev voit exactement ce que l'IA retient)
      document.getElementById('actionLogBtn')?.addEventListener('click', () => {
        const log = getProjectMemory(currentUserId).actionLog || [];
        if (!log.length) {
          appendMessageUI('assistant', '📜 Journal vide : aucune action Godot appliquée pour le moment.\nLes actions (create_node, create_script…) s\'enregistreront ici automatiquement à chaque génération.', '📜 Journal');
          return;
        }
        const lines = ['📜 Journal des actions appliquées dans Godot (ce que le modèle retient) :', '', ...log.slice(-60).reverse().map((l) => '• ' + l)];
        appendMessageUI('assistant', lines.join('\n'), '📜 Journal');
      });

      // 📊 Panneau de stats (bouton header)
      document.getElementById('statsBtn')?.addEventListener('click', () => {
        const today = new Date().toISOString().slice(0, 10);
        let s: any = { day: today, messages: 0, inputTokens: 0, outputTokens: 0 };
        try { const raw = JSON.parse(localStorage.getItem('gd4_usage_stats') || 'null'); if (raw && raw.day === today) s = raw; } catch { /* ignore */ }
        appendMessageUI('assistant', `📊 Usage du jour :\n• ${s.messages} message(s) envoyé(s)\n• ~${Number(s.inputTokens).toLocaleString('fr-FR')} tokens input estimés\n• ~${Number(s.outputTokens).toLocaleString('fr-FR')} tokens output estimés\n(remis à zéro chaque jour)`, '📊 Stats');
      });

      // 🔊 Lire une réponse à voix haute (synthèse vocale) — nouveauté GD4
      document.addEventListener('click', (e) => {
        const speakBtn = (e.target as HTMLElement).closest<HTMLButtonElement>('.speak-btn');
        if (!speakBtn) return;
        const bubble = speakBtn.closest('div')?.parentElement?.querySelector('.message-content') as HTMLElement | null;
        const text = bubble?.textContent || '';
        if (!text) return;
        try {
          if (speechSynthesis.speaking) { speechSynthesis.cancel(); speakBtn.textContent = '🔊'; return; }
          const utterance = new SpeechSynthesisUtterance(text);
          utterance.lang = 'fr-FR';
          utterance.onend = () => { speakBtn.textContent = '🔊'; };
          speakBtn.textContent = '⏹';
          speechSynthesis.speak(utterance);
        } catch { /* ignore */ }
      });

      // ⌨️ Raccourcis clavier — Ctrl/⌘+K nouvelle conversation · Ctrl+J journal · Ctrl+E export
      document.addEventListener('keydown', (e) => {
        if (!(e.ctrlKey || e.metaKey)) return;
        const key = e.key.toLowerCase();
        if (key === 'k') {
          e.preventDefault();
          window.dispatchEvent(new CustomEvent('new-chat'));
        } else if (key === 'j') {
