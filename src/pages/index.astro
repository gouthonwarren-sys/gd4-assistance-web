      // 📦 EXPORT GLOBAL : toutes les conversations du compte en un seul Markdown
      document.getElementById('exportAllBtn')?.addEventListener('click', () => {
        const chats = getChats(currentUserId);
        if (!chats.length) {
          appendMessageUI('assistant', '⚠️ Aucune conversation à exporter.', 'Système');
