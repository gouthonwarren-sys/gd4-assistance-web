      upgradeHeaderBtn?.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('open-pricing'));
        window.dispatchEvent(new CustomEvent('open-pricing-modal'));
      });

      // ============================================================
      // ENVOI DU FORMULAIRE — bouton "Envoyer" ou Entrée
      // ============================================================
      chatForm?.addEventListener('submit', async (e: Event) => {
        e.preventDefault();
        if (!promptInput || !ws) return;
        if (ws.readyState !== WebSocket.OPEN) {
          appendMessageUI('assistant', '⚠️ Relais hors ligne — impossible d\'envoyer ta question.', 'Système');
          return;
        }
        const prompt = promptInput.value.trim();
        if (!prompt) return;
        promptInput.value = '';
        const modelKey = modelSelect?.value === 'auto' ? determineAutoModel(prompt) : (modelSelect?.value || 'groq');
        const fileContext = buildProjectContext(undefined, modelKey);
        const fullPrompt = prompt + fileContext;
        // QUOTA JUSTE : on consomme les tokens INPUT estimés du prompt
        // (≈ 1 token pour 4 caractères) AVANT l'appel, pas un forfait « 1 ».
        const estInputTokens = Math.max(1, Math.ceil(fullPrompt.length / 4));
      bumpUsage(true, estInputTokens, 0);
        // Vérifier le quota avant d'envoyer
        const quota = await checkTokenQuota(currentUserId, estInputTokens, 0).catch(() => ({ ok: true }));
        updateTokenQuotaDisplay();
        if (!quota.ok) {
          appendMessageUI('assistant', '⚠️ Tokens limités atteints. La limite se réinitialise dans 8 heures.', 'Système');
          return;
        }
        rememberProjectConversation('user', prompt, modelKey);
        // Affiche le message utilisateur + ENREGISTREMENT de la conversation
        appendMessageUI('user', prompt);
        void saveMessageToStorage('user', prompt, modelKey);

        // ⏳ Animation d'attente + identifiant unique (sert à lier les actions
        // envoyées au dock Godot et à retirer l'animation).
        const requestId = 'app_' + Date.now() + '_' + Math.random().toString(36).slice(2, 8);
        const typing = appendMessageUI('assistant', '<i>⏳ Réflexion et génération en cours...</i>', '⏳ En cours');
        pendingAppRequests.set(requestId, typing);

        // 🧠 L'APPEL IA SE FAIT ICI, DIRECTEMENT DANS L'APP (le seul cerveau) :
        // la question ne part JAMAIS au plugin. Seules les ACTIONS éventuelles
        // sont envoyées au dock Godot (request_id app_ → jamais affichées comme
        // conversation dans le dock, elles s'appliquent juste à la scène).
        try {
          const result = await callGemini(modelKey, fullPrompt, currentScreenshot, currentScreenshotMime);
          typing.remove();
          pendingAppRequests.delete(requestId);
          const actions = Array.isArray(result.actions) ? result.actions : [];
          let txt = String(result.explanation || '');
          if (actions.length) txt += `\n\n✅ ${actions.length} action(s) appliquée(s) dans Godot.`;
          // QUOTA JUSTE : on décompte aussi les tokens OUTPUT estimés de la
          // réponse (≈ 1 token pour 4 caractères). Silencieux : ne bloque jamais.
          const estOutputTokens = Math.max(1, Math.ceil(txt.length / 4));
          void consumeTokenQuotaRemote(0, estOutputTokens, QUOTA_WINDOW_HOURS, DEFAULT_INPUT_TOKENS, DEFAULT_OUTPUT_TOKENS)
            .then(() => { void refreshTokenQuotaDisplay(); });
          bumpUsage(false, 0, estOutputTokens);
          playChime();
          // 🧠 MÉMOIRE : le modèle doit savoir ce qui a DÉJÀ été créé dans la
          // scène pour CONTINUER le jeu au lieu de tout refaire.
          if (actions.length) recordProjectActions(currentUserId, modelKey, actions);
          const bubble = appendMessageUI('assistant', '', selectedModelName(modelKey));
          const content = bubble.querySelector('.message-content');
          if (content) content.textContent = txt;
          void saveMessageToStorage('assistant', txt, modelKey);
          rememberProjectConversation('assistant', String(result.explanation || ''), modelKey);
          // ✅ La réponse part TOUJOURS vers le relais → plugin Godot,
          // même sans actions (sinon le plugin ne reçoit rien en conversation normale).
          if (ws.readyState === WebSocket.OPEN) {
            ws.send(JSON.stringify({
              type: "ai_result",
              request_id: requestId,
              explanation: String(result.explanation || ''),
              actions: actions,
              model: selectedModelName(modelKey),
            }));
          } else {
            console.warn('[GD4] Relais fermé : réponse IA non transmise au plugin.');
          }
        } catch (err: any) {
          typing.remove();
          pendingAppRequests.delete(requestId);
          appendMessageUI('assistant', `⚠️ Erreur : ${err?.message || err}`, 'Système');
        }
        currentScreenshot = null;
        currentScreenshotMime = 'image/png';
        attachBadge?.classList.add('hidden');
      });

      // Même logique au appui sur Entrée dans le champ texte
      promptInput?.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Enter' && !e.shiftKey) {
          e.preventDefault();
          chatForm?.dispatchEvent(new Event('submit'));
        }
      });

      // Algorithme de détection pour le Mode Auto
      // ⚡ GROQ (Qwen 3.8 27B) — cerveau par défaut de l'application.
      function determineAutoModel(_promptText: string): string {
        // Mode Auto : utilise le modèle préféré choisi dans les Paramètres
        // (« Modèles IA »). Pour l'instant, seul Qwen 3.8 27B est disponible.
        try {
          const preferred = localStorage.getItem('gd4_selected_model');
          if (preferred === 'groq') return preferred;
        } catch { /* ignore */ }
        return 'groq';
      }

      // ⚙️ SYNCHRO MODÈLE : le choix des Paramètres (« Modèles IA ») pilote le
      // sélecteur du header — et inversement (une seule source de vérité).
      const VALID_MODEL_KEYS = ['auto', 'groq'];
      (function syncModelSelection() {
        try {
          const saved = localStorage.getItem('gd4_selected_model');
          if (saved && VALID_MODEL_KEYS.includes(saved) && modelSelect) modelSelect.value = saved;
          modelSelect?.addEventListener('change', () => {
            try { localStorage.setItem('gd4_selected_model', modelSelect.value); } catch { /* ignore */ }
          });
          window.addEventListener('gd4-model-changed', (e: any) => {
            const value = String(e?.detail?.model || '');
            if (VALID_MODEL_KEYS.includes(value) && modelSelect) modelSelect.value = value;
          });
        } catch { /* ignore */ }
      })();

      // Nom lisible du modèle pour l'affichage dans le chat
      function selectedModelName(_key: string): string {
        return '⚡ Qwen 3.8 27B';
      }

      // ============================================================
      // HISTORIQUE DES CONVERSATIONS — espace du compte courant
      // ============================================================
      function resetChatView() {
        currentChatId = null;
        setActiveChatId(null, currentUserId);
        if (messagesList) { messagesList.innerHTML = ''; messagesList.classList.add('hidden'); }
        if (welcomeView) welcomeView.classList.remove('hidden');
        if (chatContainer) chatContainer.classList.add('justify-center');
        if (promptInput) { promptInput.value = ''; promptInput.focus(); }
      }

      function tryRestoreActiveChat() {
        const activeId = getActiveChatId(currentUserId);
        const chat = activeId ? getChats(currentUserId).find((c: Chat) => c.id === activeId) : undefined;
        if (chat) window.dispatchEvent(new CustomEvent('select-chat', { detail: { id: chat.id } }));
      }

      // Restauration différée : attend la fin de la synchro cloud/migration
      // (signifiée par l'événement 'chats-updated') avant de rouvrir la conversation active.
      let pendingRestoreAfterSync = false;

      window.addEventListener('new-chat', resetChatView);

      window.addEventListener('chats-updated', () => {
        updateTokenQuotaDisplay();
        if (pendingRestoreAfterSync && !currentChatId) {
          pendingRestoreAfterSync = false;
          tryRestoreActiveChat();
        }
      });

      // Connexion / déconnexion / changement de compte (émis par la Sidebar)
      window.addEventListener('gd4-auth-changed', (e: any) => {
        const user = e.detail?.user;
        const previousUserId = currentUserId;
        currentUserId = user?.id ?? null;
        currentUserEmail = user?.email || 'anonyme';
        currentScreenshot = null;
        currentScreenshotMime = 'image/png';
        attachBadge?.classList.add('hidden');

        if (previousUserId !== currentUserId) {
          resetChatView();                    // espace de données différent → vue vierge
          pendingRestoreAfterSync = !!user;   // puis restauration après synchro
          pluginChatId = null;                // la session plugin redémarre dans le nouvel espace
          updateTokenQuotaDisplay();
          void refreshTokenQuotaDisplay();      // quota réel du nouveau compte (serveur)
        }
      });

      window.addEventListener('select-chat', (e: any) => {
        const chatId = e.detail?.id;
        if (!chatId) return;
        const chats = getChats(currentUserId);
        const chat = chats.find((c: Chat) => c.id === chatId);
        if (chat && messagesList) {
          currentChatId = chat.id;
          setActiveChatId(chat.id, currentUserId);
          messagesList.innerHTML = '';
          if (welcomeView) welcomeView.classList.add('hidden');
          chatContainer?.classList.remove('justify-center');
          messagesList.classList.remove('hidden');
          chat.messages.forEach((m: ChatMessage) => appendMessageUI(m.role, m.text, m.modelName));
        }
      });

      // ============================================================
      // AFFICHAGE DES MESSAGES
      // ============================================================
      function appendMessageUI(role: 'user' | 'assistant', text: string, modelName = '') {
        // NORMALISATION : bulles affichées avec les clés brutes
        // ('groq'/'nvidia'/'cloudflare'/'auto') au lieu du nom lisible —
        // ici on reconvertit systématiquement en nom lisible AVANT affichage.
        const displayName = ['auto', 'groq', 'nvidia', 'cloudflare'].includes(modelName)
          ? selectedModelName(modelName)
          : modelName;
        if (welcomeView && !welcomeView.classList.contains('hidden')) {
          welcomeView.classList.add('hidden');
          chatContainer?.classList.remove('justify-center');
          messagesList?.classList.remove('hidden');
        }

        const msgDiv = document.createElement('div');
        msgDiv.className = `p-4 rounded-2xl text-xs md:text-sm max-w-2xl leading-relaxed relative group ${
          role === 'user'
            ? 'bg-cyan-950/40 border border-cyan-800/50 text-slate-100 ml-auto'
            : 'bg-[#16181c] border border-slate-800 text-slate-200 mr-auto shadow-lg'
        }`;

        if (role === 'assistant') {
          msgDiv.innerHTML = `
            <div class="flex items-center justify-between mb-2 pb-1.5 border-b border-slate-800/80 text-[10px] font-mono text-cyan-400">
              <span>🤖 Modèle actif : ${displayName}</span>
            </div>
            <div class="message-content whitespace-pre-wrap font-sans">${text}</div>

            <div class="flex items-center gap-1.5 pt-3 mt-2 border-t border-slate-800/60 text-slate-400">
              <button type="button" class="copy-btn hover:text-cyan-400 p-1.5 rounded-lg hover:bg-slate-800 transition flex items-center gap-1 cursor-pointer" title="Copier la réponse">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
                <span class="copy-label text-[10px]">Copier</span>
              </button>

              <button type="button" class="speak-btn hover:text-cyan-400 p-1.5 rounded-lg hover:bg-slate-800 transition cursor-pointer text-xs" title="Lire la réponse à voix haute">🔊</button>

              <button type="button" class="like-btn hover:text-emerald-400 p-1.5 rounded-lg hover:bg-slate-800 transition cursor-pointer" title="Bonne réponse">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2" />
                </svg>
              </button>

              <button type="button" class="dislike-btn hover:text-rose-400 p-1.5 rounded-lg hover:bg-slate-800 transition cursor-pointer" title="Mauvaise réponse">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14H5.236a2 2 0 01-1.789-2.894l3.5-7A2 2 0 018.736 3h4.018c.163 0 .326.02.485.06L17 4m-7 10v5a2 2 0 002 2h.095c.5 0 .905-.405.905-.905 0-.714.211-1.412.608-2.006L17 13V4m-7 10h2m5-6h2a2 2 0 012 2v6a2 2 0 01-2 2h-2" />
                </svg>
              </button>
            </div>
          `;
        } else {
          msgDiv.innerHTML = `
            <div class="message-content whitespace-pre-wrap font-sans">${text}</div>

            <div class="flex items-center gap-1.5 pt-2 mt-2 border-t border-cyan-800/40 text-cyan-400/80 justify-end">
              <button type="button" class="edit-btn hover:text-cyan-200 p-1 rounded-lg hover:bg-cyan-900/40 transition flex items-center gap-1 cursor-pointer" title="Modifier le prompt">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                </svg>
                <span class="text-[10px]">Modifier</span>
              </button>

              <button type="button" class="copy-btn hover:text-cyan-200 p-1 rounded-lg hover:bg-cyan-900/40 transition flex items-center gap-1 cursor-pointer" title="Copier le prompt">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
              </button>
            </div>
          `;
        }

        const contentDiv = msgDiv.querySelector('.message-content');
        const copyBtn = msgDiv.querySelector('.copy-btn');
        const copyLabel = msgDiv.querySelector('.copy-label');
        const editBtn = msgDiv.querySelector('.edit-btn');
        const likeBtn = msgDiv.querySelector('.like-btn');
        const dislikeBtn = msgDiv.querySelector('.dislike-btn');

        copyBtn?.addEventListener('click', () => {
          if (contentDiv) {
            navigator.clipboard.writeText(contentDiv.textContent || '');
            if (copyLabel) copyLabel.textContent = 'Copié !';
            setTimeout(() => { if (copyLabel) copyLabel.textContent = 'Copier'; }, 2000);
          }
        });

        editBtn?.addEventListener('click', () => {
          if (contentDiv && promptInput) {
            promptInput.value = contentDiv.textContent || '';
            promptInput.focus();
          }
        });

        likeBtn?.addEventListener('click', () => {
          likeBtn.classList.toggle('text-emerald-400');
          dislikeBtn?.classList.remove('text-rose-400');
        });

        dislikeBtn?.addEventListener('click', () => {
          dislikeBtn.classList.toggle('text-rose-400');
          likeBtn?.classList.remove('text-emerald-400');
        });

        messagesList?.appendChild(msgDiv);
        chatContainer?.scrollTo({ top: chatContainer.scrollHeight, behavior: 'smooth' });
        return msgDiv;
      }

      function appendScreenshotUI(base64: string, mime: string, label: string): void {
        if (!messagesList || !base64) return;
        if (welcomeView && !welcomeView.classList.contains('hidden')) {
          welcomeView.classList.add('hidden');
          chatContainer?.classList.remove('justify-center');
          messagesList.classList.remove('hidden');
        }

        const wrapper = document.createElement('div');
        wrapper.className = 'max-w-2xl mr-auto bg-[#16181c] border border-emerald-900/60 rounded-2xl p-3 shadow-lg';
        const image = document.createElement('img');
        image.src = `data:${mime};base64,${base64}`;
        image.alt = label;
        image.className = 'block max-w-full max-h-[420px] rounded-xl border border-slate-700/80 object-contain';
        const caption = document.createElement('div');
        caption.className = 'text-[10px] text-emerald-300 mt-2';
        caption.textContent = `📸 ${label} — sera utilisée avec ta prochaine question`;
        wrapper.append(image, caption);
        messagesList.appendChild(wrapper);
        chatContainer?.scrollTo({ top: chatContainer.scrollHeight, behavior: 'smooth' });
      }

      // ---- Drag & Drop d'images dans le chat ----
      // Note: chatContainer, messagesList, welcomeView sont déjà déclarés plus haut (lignes ~235-237)
      const dropHint = document.getElementById('dropHint') as HTMLDivElement | null;

      function handleDropOrFile(file: File) {
        if (!file || !file.type.startsWith('image/')) return;
        const reader = new FileReader();
        reader.onload = async () => {
          const dataUrl = typeof reader.result === 'string' ? reader.result : '';
          const b64 = dataUrl.includes(',') ? dataUrl.split(',')[1] : dataUrl;
          const mime = file.type || 'image/png';
          
          if (!b64) return;
          
          if (welcomeView && !welcomeView.classList.contains('hidden')) {
            welcomeView.classList.add('hidden');
            chatContainer?.classList.remove('justify-center');
            messagesList?.classList.remove('hidden');
          }
          
          // Affiche l'image dans le chat
          appendScreenshotUI(b64, mime, `Image glissée (${file.name})`);
          
          // Si WebSocket est connecté, prépare l'image pour la prochaine question
          if (ws && ws.readyState === WebSocket.OPEN) {
            currentScreenshot = b64;
            currentScreenshotMime = mime;
          }
        };
        reader.readAsDataURL(file);
      }

      if (chatContainer) {
        chatContainer.addEventListener('dragenter', (e) => {
          e.preventDefault();
          e.stopPropagation();
          chatContainer.classList.add('drag-over');
          if (dropHint) dropHint.classList.remove('hidden');
        });

        chatContainer.addEventListener('dragover', (e) => {
          e.preventDefault();
          e.stopPropagation();
          chatContainer.classList.add('drag-over');
          if (dropHint) dropHint.classList.remove('hidden');
        });

        chatContainer.addEventListener('dragleave', (e) => {
          e.preventDefault();
          e.stopPropagation();
          if (!chatContainer.contains(e.relatedTarget)) {
            chatContainer.classList.remove('drag-over');
            if (dropHint) dropHint.classList.add('hidden');
          }
        });

        chatContainer.addEventListener('drop', (e) => {
          e.preventDefault();
          e.stopPropagation();
          chatContainer.classList.remove('drag-over');
          if (dropHint) dropHint.classList.add('hidden');
          
          const files = e.dataTransfer?.files;
          if (files && files.length > 0) {
            for (const file of files) {
              handleDropOrFile(file);
            }
          }
        });
      }

      // Empêche le comportement par défaut du navigateur sur toute la page
      document.addEventListener('dragenter', (e) => {
        e.preventDefault();
      });
      document.addEventListener('dragover', (e) => {
        e.preventDefault();
      });
      document.addEventListener('drop', (e) => {
        e.preventDefault();
      });

      async function saveMessageToStorage(role: 'user' | 'assistant', text: string, modelName = '') {
        const message: ChatMessage = modelName ? { role, text, modelName } : { role, text };

        if (!currentChatId) {
          currentChatId = 'chat_' + Date.now();
          setActiveChatId(currentChatId, currentUserId);
          const newTitle = role === 'user' ? (text.slice(0, 30) + (text.length > 30 ? '...' : '')) : 'Nouvelle conversation';
          await upsertChat({ id: currentChatId, title: newTitle, messages: [message] }, currentUserId);
          return;
        }

        const chats = getChats(currentUserId);
        const target = chats.find((c: Chat) => c.id === currentChatId);
        if (target) {
          target.messages.push(message);
          await upsertChat(target, currentUserId);
        } else {
          // Conversation absente de cet espace (ex. changement de compte) → recréation
          await upsertChat({ id: currentChatId, title: 'Nouvelle conversation', messages: [message] }, currentUserId);
        }
      }

      // ============================================================
      // CONVERSATIONS DU PLUGIN GODOT → historique de l'APP
      // Chaque échange plugin devient un chat rattaché au COMPTE qui a
      // créé le code d'appairage (upsertChat → espace du compte + cloud).
      // Nouvelle conversation si plus de 2 h d'inactivité (session plugin).
      // ============================================================
      const PLUGIN_SESSION_GAP_MS = 2 * 60 * 60 * 1000;
      let pluginChatId: string | null = null;

      function pluginChatKey(): string {
        return currentUserId ? `gd4_plugin_chat_id::u:${currentUserId}` : 'gd4_plugin_chat_id';
      }

      async function savePluginExchange(question: string, answer: string, modelKey: string) {
        try {
          if (!pluginChatId) pluginChatId = localStorage.getItem(pluginChatKey());
          let chat = pluginChatId ? getChats(currentUserId).find((c: Chat) => c.id === pluginChatId) : undefined;

          // Session expirée → nouvelle conversation
          if (chat && chat.updatedAt && Date.now() - chat.updatedAt > PLUGIN_SESSION_GAP_MS) {
            chat = undefined;
          }

          if (!chat) {
            pluginChatId = 'plug_' + Date.now();
            localStorage.setItem(pluginChatKey(), pluginChatId);
            chat = {
              id: pluginChatId,
              title: '🔌 ' + question.slice(0, 30) + (question.length > 30 ? '...' : ''),
              messages: [],
            };
          }

          chat.messages.push({ role: 'user', text: question, modelName: '🔌 Plugin Godot' });
          chat.messages.push({ role: 'assistant', text: answer, modelName: `🔌 Plugin (${modelKey})` });
          await upsertChat(chat, currentUserId); // compte courant + cloud + événement 'chats-updated'
        } catch (e: any) {
          console.warn('[GD4] Sauvegarde de la conversation plugin impossible :', e?.message || e);
        }
      }

      /** Import en masse d'un historique envoyé par le plugin (type: "plugin_history"). */
      async function importPluginHistory(chats: any[]) {
        let imported = 0;
        for (const c of chats) {
          if (!c || !Array.isArray(c.messages) || c.messages.length === 0) continue;
          const messages: ChatMessage[] = c.messages
            .filter((m: any) => m && typeof m.text === 'string')
            .map((m: any) => ({
              role: m.role === 'assistant' ? 'assistant' : 'user',
              text: String(m.text),
              modelName: '🔌 Plugin Godot',
            }));
          if (messages.length === 0) continue;
          const title = typeof c.title === 'string' && c.title.trim()
            ? '🔌 ' + c.title.trim().slice(0, 40)
            : '🔌 Conversation plugin';
          await upsertChat(
            { id: 'plug_' + Date.now() + '_' + imported, title, messages },
            currentUserId,
          );
          imported++;
        }
        if (imported > 0) {
          console.log(`[GD4] ${imported} conversation(s) du plugin importée(s) dans le compte.`);
        }
      }

      // Restaurer le compte au démarrage (session Google existante) puis rouvrir sa conversation active
      (async () => {
        const me = await resolveCurrentUser().catch(() => null);
        if (me && me.id !== currentUserId) {
          currentUserId = me.id;
          currentUserEmail = me.email || 'anonyme';
          currentChatId = getActiveChatId(currentUserId);
          pendingRestoreAfterSync = true;
        }
        void refreshTokenQuotaDisplay();
        updateTokenQuotaDisplay();
        if (currentChatId) {
          window.dispatchEvent(new CustomEvent('select-chat', { detail: { id: currentChatId } }));
        }
      })();

      // L'envoi du chat est géré une seule fois ci-dessus (événement 'submit' du formulaire).
    </script>
  </body>
</html>