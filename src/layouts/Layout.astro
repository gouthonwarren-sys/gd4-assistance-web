---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="fr" class="dark h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="GD4 Assistant - Application IA pour Godot Engine" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    <!-- CDN Tailwind CSS (Rendu instantané) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        darkMode: 'class',
        theme: {
          extend: {
            colors: {
              darkBg: '#141619',
              sidebarBg: '#181a1d',
              cardBg: '#1e2227'
            }
          }
        }
      }
    </script>
  </head>
  <body class="bg-[#141619] text-slate-100 h-full m-0 p-0 antialiased overflow-hidden">
    <slot />
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }
  html, body {
    height: 100%;
    width: 100%;
    background-color: #141619;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
  }
</style>